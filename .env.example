APP_PORT=443

POSTGRES_USER=railsafe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=railsafe

JWT_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
TWO_FACTOR_SECRET=replace-with-another-long-random-secret

ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me

COOKIE_SECURE=true
CORS_ORIGINS=https://YOUR_PUBLIC_HOST:PORT
VITE_API_BASE_URL=/api

TLS_COMMON_NAME=YOUR_PUBLIC_HOST
TLS_SAN=DNS:YOUR_PUBLIC_HOST
TLS_CERT_DAYS=365

TWO_FACTOR_ENABLED=false
TWO_FACTOR_TTL_SECONDS=300
TWO_FACTOR_MAX_ATTEMPTS=5
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=railsafe@example.com
SMTP_PASSWORD=change-me-or-app-password
SMTP_FROM=railsafe@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
